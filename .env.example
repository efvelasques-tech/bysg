# Copiar como .env únicamente al momento de configurar un entorno real.
BYSG_HOST=127.0.0.1
BYSG_PORT=4180
BYSG_BASE_URL=http://127.0.0.1:4180
# Candidato: bysg.com. Reemplazar únicamente después de registrarlo y configurar DNS.
BYSG_DOMAIN=tienda.example.com
BYSG_DATABASE=data/bysg.sqlite3
# Dejar en false durante pruebas. Los cobros reales requieren true y el checklist completo.
BYSG_PRODUCTION=false
BYSG_BACKUP_RETENTION=30

# Cambiar los tres secretos antes de exponer el servidor en Internet.
BYSG_SESSION_SECRET=CAMBIAR-por-un-secreto-largo-y-aleatorio
BYSG_ADMIN_PASSWORD=CAMBIAR-clave-administrador
BYSG_BAUTI_CODE=CAMBIAR-codigo-consulta-seguro

# mock: pagos simulados locales. mercado_pago_prueba: ensayo local. mercado_pago: Orders API real.
BYSG_PAYMENT_MODE=mock
MP_ACCESS_TOKEN=
# ID numérico del vendedor titular; la order remota debe pertenecer a esta cuenta.
MP_SELLER_ID=
MP_WEBHOOK_SECRET=

# Correo automático. Si SMTP_HOST queda vacío, los mensajes se guardan en
# la bandeja de salida del panel y no se envían.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Datos legales del adulto titular. Deben completarse con los datos reales de
# Emilio antes de publicar; no usar información de muestra.
BYSG_LEGAL_NAME=
BYSG_LEGAL_CUIT=
BYSG_CONTACT_EMAIL=
BYSG_BUSINESS_ADDRESS=

# Canales públicos opcionales. Los enlaces vacíos permanecen ocultos.
BYSG_WHATSAPP_URL=
BYSG_INSTAGRAM_URL=
BYSG_TIKTOK_URL=
BYSG_YOUTUBE_URL=https://www.youtube.com/@batmanysusgatos

# Valores de prueba editables, expresados en centavos de ARS.
BYSG_PRICE_REMERAS=2500000
BYSG_PRICE_BUZOS=4800000
BYSG_PRICE_GORRAS=2000000
BYSG_SHIPPING_HOME=
BYSG_SHIPPING_MERCADO_ENVIOS=
BYSG_SHIPPING_CORREO_ARGENTINO=
BYSG_SHIPPING_COURIER=
BYSG_SHIPPING_KEY_WEST=
